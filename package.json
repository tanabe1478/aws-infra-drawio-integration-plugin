{
  "name": "aws-infra-drawio",
  "version": "0.1.0",
  "type": "module",
  "description": "Claude Code plugin: Terraform -> structure.yaml -> .drawio (AWS architecture diagrams), wrapping the official draw.io MCP server.",
  "license": "MIT",
  "author": "tanabe1478",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanabe1478/aws-infra-drawio-integration-plugin.git"
  },
  "keywords": [
    "aws",
    "drawio",
    "diagram",
    "terraform",
    "mcp",
    "claude-code",
    "claude-code-plugin"
  ],
  "bin": {
    "aws-infra-drawio": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "skills",
    "vendor",
    "examples",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "validate": "node scripts/validate-structure.mjs",
    "render": "node scripts/render-drawio.mjs",
    "gen:shape-map": "node scripts/gen-shape-map.mjs",
    "test": "bash scripts/selftest.sh"
  },
  "dependencies": {
    "@drawio/mcp": "^1.5.0",
    "yaml": "^2.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
